# Bash completion for desktop-app: roles from apps.conf, actions from APP-wrapper --list.
_desktop_app() {
    local config=${XDG_CONFIG_HOME:-$HOME/.config}/devuan-machine-config/apps.conf
    local cur=${COMP_WORDS[COMP_CWORD]}
    [ -r "$config" ] || return 0

    if [ "$COMP_CWORD" -eq 1 ]; then
        local roles
        roles=$(sed -n 's/^\([a-z0-9-]\+\)=.*/\1/p' "$config")
        COMPREPLY=($(compgen -W "--list $roles" -- "$cur"))
    elif [ "$COMP_CWORD" -eq 2 ]; then
        local app
        app=$(sed -n "s/^${COMP_WORDS[1]}=//p" "$config" | sed -n '1p')
        [[ $app =~ ^[A-Za-z0-9._+-]+$ ]] || return 0
        command -v "$app-wrapper" >/dev/null 2>&1 || return 0
        COMPREPLY=($(compgen -W "$("$app-wrapper" --list 2>/dev/null | cut -f1)" -- "$cur"))
    fi
}
complete -F _desktop_app desktop-app
