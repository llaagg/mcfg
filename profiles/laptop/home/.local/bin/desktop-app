#!/bin/sh
# Launch the selected application for a logical role.
# Usage: desktop-app ROLE [ARG ...]
set -eu

role=${1:-}
[ -n "$role" ] || {
    echo "Usage: desktop-app ROLE [ARG ...]" >&2
    exit 2
}
shift
case "$role" in
    *[!a-z0-9-]*|"") echo "Invalid application role: $role" >&2; exit 2 ;;
esac

config=${XDG_CONFIG_HOME:-"$HOME/.config"}/devuan-machine-config/apps.conf
app=
if [ -r "$config" ]; then
    app=$(sed -n "s/^${role}=//p" "$config" | sed -n '1p')
fi
[ -n "$app" ] || {
    echo "No application configured for role '$role' in $config" >&2
    exit 127
}
case "$app" in
    *[!A-Za-z0-9._+-]*|"") echo "Invalid executable name for '$role': $app" >&2; exit 2 ;;
esac
if ! command -v "$app" >/dev/null 2>&1; then
    echo "Configured application '$app' for '$role' is not installed or not in PATH" >&2
    exit 127
fi
exec "$app" "$@"
